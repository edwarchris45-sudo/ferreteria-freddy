<script src="config.js"></script>
<script>
const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const safeUrl=u=>{u=(u||"").trim();if(/^https?:\/\//i.test(u))return u;if(/^\d{7,}$/.test(u))return"https://wa.me/"+u;return""};
const DEF={n1:"FERRETERÍA",n2:"FREDDY",ht:"Todo para tu obra y tu hogar",hs:"",wa:"",ct:"",cb:"#2958a8",cy:"#f8dc08",cn:"#101c34",logo:""};
const LOGO='<svg viewBox="0 0 48 52"><path d="M24 2l20 11v26L24 50 4 39V13z" fill="#f8dc08"/><path d="M14 16h20v7H22v5h9v6h-9v8h-8z" fill="#2958a8"/></svg>';
let sb=null,S={...DEF},cats=[],prods=[],ads=[],cart={},role=null,myEmail=null,DEMO=false;
const CK="ff_cart";try{cart=JSON.parse(localStorage.getItem(CK)||"{}")||{}}catch(e){cart={}}
const saveCart=()=>{try{localStorage.setItem(CK,JSON.stringify(cart))}catch(e){}};
function toast(t){const e=$("toast");e.textContent=t;e.classList.add("on");clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove("on"),1600)}
const isAdmin=()=>!!role;
function applySite(){const r=document.documentElement.style;r.setProperty("--blue",S.cb);r.setProperty("--yellow",S.cy);r.setProperty("--navy",S.cn);
 $("nm").textContent=S.n1;$("nm2").textContent=S.n2;$("hT").textContent=S.ht;$("hS").textContent=S.hs||"";$("fN").textContent=S.n1+" "+S.n2;$("fC").textContent=S.ct||"";
 $("logoBox").innerHTML=S.logo?'<img alt="logo" src="'+esc(S.logo)+'">':LOGO;$("wa").style.display=S.wa?"block":"none";document.title=S.n1+" "+S.n2}
function pic(p){return p.thumb?'<img loading="lazy" alt="'+esc(p.name)+'" src="'+esc(p.thumb)+'" onclick="zoom(\''+esc(p.full||p.thumb)+'\')">':(()=>{const c=cats.find(c=>c.id===p.cat)||{};return c.img?'<img alt="" src="'+esc(c.img)+'">':c.emoji||"🛠"})()}
function zoom(u){$("lbi").src=u;$("lb").classList.add("on")}
function card(p){return '<div class="card">'+(p.offer?'<span class="tag">OFERTA</span>':'')+'<div class="ph">'+pic(p)+'</div><div class="b"><h3>'+esc(p.name)+'</h3><div><span class="pr">'+esc(p.price)+'</span>'+(p.old_price?'<span class="old">'+esc(p.old_price)+'</span>':'')+'</div><button onclick="add(\''+p.id+'\')">+ Agregar a mi lista</button>'+(isAdmin()?'<div class="ctl"><button class="g" onclick="editProd(\''+p.id+'\')">Editar</button><button class="r" onclick="delProd(\''+p.id+'\')">Borrar</button></div>':'')+'</div></div>'}
const media=a=>a.video?`<video src="${esc(a.video)}" muted loop playsinline autoplay preload="metadata"></video>`:a.img?`<img alt="" src="${esc(a.img)}">`:"";
function promoCard(a){const u=safeUrl(a.link),t=u?`a href="${esc(u)}" target="_blank" rel="noopener sponsored"`:"div";return `<${t} class="pm"><i class="spb">${a.own?"Ferretería Freddy":"Patrocinado"}</i>${isAdmin()?`<button class="pe" onclick="event.preventDefault();event.stopPropagation();editAd('${a.id}')">📷 Cambiar foto / video</button>`:""}${media(a)}<div><b>${esc(a.title)}</b><span>${esc(a.body)}</span></div></${t.split(" ")[0]}>`}
function adCard(a){const u=safeUrl(a.link),t=u?'a href="'+esc(u)+'" target="_blank" rel="noopener sponsored"':'div';return '<'+t+' class="ad">'+(media(a)||'<div style="font-size:34px">📣</div>')+'<div><i class="spl">'+(a.own?'Ferretería Freddy':'Patrocinado')+'</i><b>'+esc(a.title)+'</b><span>'+esc(a.body)+'</span></div></'+t.split(" ")[0]+'>'}
function render(){const q=$("q").value.toLowerCase().trim(),list=prods.filter(p=>!q||p.name.toLowerCase().includes(q));
 $("nav").innerHTML='<button class="y cdb" onclick="toggleCats(this)">☰ Buscar por Categorías ▾</button><a href="#top">Inicio</a><a href="#ofertas">🔥 Ofertas</a><a href="#noticias">Noticias</a><a href="#nosotros">Nosotros</a><a href="#sucursales">Sucursales</a>'+cats.map(c=>'<a href="#c-'+c.id+'">'+esc(c.emoji||"🛠")+" "+esc(c.name)+'</a>').join("");
 const of=list.filter(p=>p.offer);
 let h='<h2 class="of" id="ofertas">🔥 Ofertas</h2>'+(of.length||isAdmin()?'<div class="grid">'+of.map(card).join("")+addTile("of")+'</div>':'<p class="empty">Pronto publicaremos nuevas ofertas.</p>');
 cats.forEach(c=>{const ps=list.filter(p=>p.cat===c.id);h+='<h2 id="c-'+c.id+'">'+ci(c)+esc(c.name)+'</h2>'+(ps.length||isAdmin()?'<div class="grid">'+ps.map(card).join("")+addTile(c.id)+'</div>':'<p class="empty">Próximamente productos en esta sección.</p>')});
 $("content").innerHTML=h;$("cc").textContent=Object.values(cart).reduce((a,b)=>a+b,0);
 const pm=ads.filter(a=>a.kind==="promo"),mk=ads.filter(a=>a.kind!=="promo");$("adsG").innerHTML=mk.map(adCard).join("");$("adsWrap").style.display=mk.length?"block":"none";$("promos").innerHTML=pm.map(promoCard).join("");$("promos").style.display=pm.length?"grid":"none";
 $("pc").innerHTML=cats.map(c=>'<option value="'+c.id+'">'+esc(c.name)+'</option>').join("");
 $("catL").innerHTML=cats.map(c=>'<div class="li"><span>'+(c.img?'<img class="ct" src="'+esc(c.img)+'"> ':esc(c.emoji||"")+" ")+esc(c.name)+'</span><button class="g" onclick="catPhoto(\''+c.id+'\')">📷 Foto</button><button class="r" onclick="delCat(\''+c.id+'\')">Quitar</button></div>').join("");
 $("adL").innerHTML=ads.map(a=>'<div class="li"><span>'+esc(a.title)+(a.kind==="promo"?" · banner":" · marca")+(a.video?" 🎬":"")+'</span><button class="g" onclick="editAd(\''+a.id+'\')">Editar</button><button class="r" onclick="delAd(\''+a.id+'\')">Quitar</button></div>').join("")||'<p class="note">Sin anuncios.</p>'}
async function load(){const[a,b,c,d,e]=await Promise.all([sb.from("settings").select("*").eq("id",1).maybeSingle(),sb.from("categories").select("*").order("ord"),sb.from("products").select("*").order("created_at",{ascending:false}),sb.from("ads").select("*").order("created_at"),sb.from("posts").select("*").order("created_at",{ascending:false})]);
 if([a,b,c,d].some(x=>x.error)&&!cats.length&&!prods.length){$("content").innerHTML='<p class="empty">⚠ No pudimos cargar el catálogo. Revisa tu conexión e inténtalo de nuevo en unos minutos.</p>';return}
 S={...DEF,...(a.data||{})};cats=b.data||[];prods=c.data||[];ads=d.data||[];posts=e.data||[];Object.keys(cart).forEach(i=>{if(!prods.find(p=>p.id===i))delete cart[i]});saveCart();applySite();render()}
function add(id){cart[id]=(cart[id]||0)+1;saveCart();render();const p=prods.find(x=>x.id===id);toast("✔ "+(p?p.name:"Producto")+" agregado a tu lista")}
function openCart(){const ids=Object.keys(cart).filter(i=>cart[i]>0);$("cartL").innerHTML=ids.length?ids.map(i=>{const p=prods.find(x=>x.id===i);return p?'<div class="li"><span>'+esc(p.name)+'<br><b>'+esc(p.price)+'</b></span><span class="qty"><button class="g" onclick="qty(\''+i+'\',-1)">−</button>'+cart[i]+'<button class="g" onclick="qty(\''+i+'\',1)">+</button></span></div>':""}).join(""):'<p class="empty">Tu lista está vacía.</p>';cartP.classList.add("on")}
function qty(i,d){cart[i]=Math.max(0,(cart[i]||0)+d);saveCart();render();openCart()}
function sendWA(){const items=Object.keys(cart).filter(i=>cart[i]>0).map(i=>{const p=prods.find(x=>x.id===i);return p?"• "+cart[i]+" x "+p.name+" ("+p.price+")":""}).filter(Boolean);
 const t="Hola, soy "+($("cn").value||"un cliente")+". Quisiera consultar:\n"+(items.join("\n")||"(información general)")+($("cnote").value?"\nNota: "+$("cnote").value:"");
 if(!S.wa)return alert("El negocio aún no configuró su WhatsApp.");window.open("https://wa.me/"+S.wa.replace(/\D/g,"")+"?text="+encodeURIComponent(t),"_blank")}
async function sendSug(){if(DEMO)return $("sgM").textContent="Modo demostración: aún no se guardan sugerencias.";const p=$("sgP").value.trim();if(!p||$("sgH").value)return $("sgM").textContent=p?"":"Escribe qué producto necesitas";
 const r=await sb.from("suggestions").insert({product:p,details:$("sgD").value,customer:$("sgN").value});
 $("sgM").textContent=r.error?"No se pudo enviar, intenta de nuevo.":"✅ ¡Gracias! Anotamos tu sugerencia.";if(!r.error)["sgP","sgD","sgN"].forEach(i=>$(i).value="")}
/* ---- imágenes ---- */
function toBlob(file,max,type,q){return new Promise((ok,no)=>{const im=new Image(),u=URL.createObjectURL(file);im.onload=()=>{const k=Math.min(1,max/Math.max(im.width,im.height)),c=document.createElement("canvas");c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext("2d").drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);c.toBlob(b=>b?ok(b):no(new Error("No se pudo procesar")),type,q)};im.onerror=()=>no(new Error("Imagen no válida"));im.src=u})}
async function put(path,blob,type){const r=await sb.storage.from("media").upload(path,blob,{contentType:type,cacheControl:"31536000"});if(r.error)throw r.error;return sb.storage.from("media").getPublicUrl(path).data.publicUrl}
const uid=()=>crypto.randomUUID();
async function upPhoto(file,q){const id=uid(),thumb=await put("p/"+id+"-t.jpg",await toBlob(file,640,"image/jpeg",.8),"image/jpeg");let full;
 if(q==="orig"){if(file.size>10*1048576)throw new Error("La foto original pesa más de 10 MB");const ext=(file.type.split("/")[1]||"jpg").replace("jpeg","jpg");full=await put("p/"+id+"-o."+ext,file,file.type)}
 else full=await put("p/"+id+"-f.jpg",await toBlob(file,+q,"image/jpeg",.92),"image/jpeg");return{thumb,full}}
async function upSmall(file,max,png){return put((png?"logo/":"a/")+uid()+(png?".png":".jpg"),await toBlob(file,max,png?"image/png":"image/jpeg",.85),png?"image/png":"image/jpeg")}
/* ---- acceso ---- */
function lmsg(t){$("lm").textContent=t}
async function login(){if(DEMO){if($("lp").value!=="freddy123")return lmsg("⚠ Contraseña incorrecta (en la demostración es: freddy123)");role="owner";lmsg("");loginP.classList.remove("on");$("lp").value="";return demoUI()}const r=await sb.auth.signInWithPassword({email:$("le").value.trim(),password:$("lp").value});lmsg(r.error?"⚠ Correo o contraseña incorrectos":"")}
async function signup(){if($("lp").value.length<8)return lmsg("⚠ La contraseña debe tener al menos 8 caracteres");const r=await sb.auth.signUp({email:$("le").value.trim(),password:$("lp").value});lmsg(r.error?"⚠ "+r.error.message:"Revisa tu correo para confirmar la cuenta y luego entra.")}
async function resetPw(){const e=$("le").value.trim();if(!e)return lmsg("Escribe tu correo arriba");const r=await sb.auth.resetPasswordForEmail(e,{redirectTo:location.origin});lmsg(r.error?"⚠ "+r.error.message:"Te enviamos un correo para cambiar la contraseña.")}
async function logout(){if(DEMO){role=null;return demoUI()}await sb.auth.signOut()}
async function setPw(){const v=$("np").value;if(v.length<8)return $("rm").textContent="⚠ Mínimo 8 caracteres";const r=await sb.auth.updateUser({password:v});if(r.error)return $("rm").textContent="⚠ "+r.error.message;$("np").value="";$("rm").textContent="";recP.classList.remove("on");history.replaceState(null,"",location.pathname);toast("✅ Contraseña actualizada")}
async function check(session){role=null;myEmail=session?.user?.email?.toLowerCase()||null;
 if(session){const r=await sb.from("admins").select("role").eq("email",myEmail).maybeSingle();role=r.data?r.data.role:null}
 $("adminBtn").style.display=role?"block":"none";$("admLogin").style.display=role?"none":"block";$("um").style.display=role?"block":"none";$("umn").textContent=(myEmail||"Administrador").split("@")[0];if(role)loginP.classList.remove("on");else admP.classList.remove("on");render()}
/* ---- administración ---- */
function msg(t){$("adMsg").textContent=t;setTimeout(()=>$("adMsg").textContent="",4000)}
async function fillAdmin(){const s=S;$("sab").value=s.about||"";$("sbr").value=s.branches||"";$("sn1").value=s.n1;$("sn2").value=s.n2;$("sht").value=s.ht;$("shs").value=s.hs||"";$("swa").value=s.wa||"";$("sct").value=s.ct||"";$("scb").value=s.cb;$("scy").value=s.cy;$("scn").value=s.cn;
 $("teamBox").style.display=role==="owner"?"block":"none";if(!DEMO){loadSubs();loadSugs();if(role==="owner")loadTeam()}}
async function saveProd(){const name=$("pn").value.trim();if(!name)return msg("Escribe el nombre");
 if(DEMO){const f=$("pi").files[0],id=$("pid").value,row={name,price:$("pp").value||"Consultar",old_price:$("po").value,cat:$("pc").value||null,offer:$("pof").checked};if(f)row.thumb=row.full=URL.createObjectURL(f);if(id)Object.assign(prods.find(x=>x.id===id),row);else prods.unshift({id:"d"+Date.now(),...row});clearForm();render();return msg("✅ Producto guardado (demostración)")}
 const b=$("sv");b.disabled=true;b.textContent="Guardando...";
 try{const row={name,price:$("pp").value||"Consultar",old_price:$("po").value,cat:$("pc").value||null,offer:$("pof").checked},f=$("pi").files[0];
  if(f){const i=await upPhoto(f,$("pq").value);row.thumb=i.thumb;row.full=i.full}
  const id=$("pid").value,r=id?await sb.from("products").update(row).eq("id",id):await sb.from("products").insert(row);if(r.error)throw r.error;clearForm();await load();msg("✅ Producto guardado")}
 catch(e){msg("⚠ "+(e.message||"Error"))}b.disabled=false;b.textContent="Guardar producto"}
function clearForm(){["pid","pn","pp","po"].forEach(i=>$(i).value="");$("pof").checked=false;$("pi").value="";$("pf").textContent="➕ Nuevo producto"}
function editProd(id){const p=prods.find(x=>x.id===id);if(!p)return;admP.classList.add("on");fillAdmin();$("pid").value=id;$("pn").value=p.name;$("pp").value=p.price;$("po").value=p.old_price||"";$("pc").value=p.cat||"";$("pof").checked=!!p.offer;$("pf").textContent="✏️ Editar producto (la foto actual se mantiene si no eliges otra)"}
async function delProd(id){if(!confirm("¿Borrar este producto?"))return;if(DEMO){prods=prods.filter(p=>p.id!==id);return render()}const r=await sb.from("products").delete().eq("id",id);if(r.error)alert(r.error.message);await load()}
async function addCat(){const n=$("cnm").value.trim();if(!n)return;const f=$("cim").files[0];
