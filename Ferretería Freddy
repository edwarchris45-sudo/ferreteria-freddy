 <p><button style="width:100%" onclick="setPw()">Guardar contraseña</button></p><p class="note" id="rm"></p>
</div></div>

<div class="panel qa" id="qaP" onclick="if(event.target===this)this.classList.remove('on')"><div class="sheet">
