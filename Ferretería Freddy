/* ===== Movimiento e interacción ===== */
.hero h1,.hero p,.hero button{transition:opacity .35s,transform .35s}.hero.out h1,.hero.out p,.hero.out button{opacity:0;transform:translateY(12px)}
.dots{position:absolute;left:8vw;bottom:62px;display:flex;gap:8px}.dots i{width:10px;height:10px;border-radius:99px;background:#fff6;cursor:pointer;transition:.3s}.dots i.on{width:28px;background:var(--yellow)}
