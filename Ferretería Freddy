 <label>Sección</label><select id="qc"></select><label><input type="checkbox" id="qf" style="width:auto"> 🔥 Está en oferta</label>
 <label>Foto</label><input type="file" id="qi" accept="image/*">
 <p><button class="y" id="qs" style="width:100%" onclick="qSave()">Guardar y agregar otro</button></p><p class="note" id="qm"></p>
</div></div>

<div class="panel qa" id="rdP" onclick="if(event.target===this)this.classList.remove('on')"><div class="sheet">
 <div class="row"><h2 id="rdT" style="margin:0"></h2><button class="g n" onclick="rdP.classList.remove('on')">Cerrar</button></div>
 <p class="note" id="rdD"></p><img id="rdI" alt=""><p id="rdB" style="white-space:pre-wrap"></p>
</div></div>

<div class="panel" id="admP" onclick="if(event.target===this)this.classList.remove('on')"><div class="sheet">
 <div class="row"><h2 style="margin:0">⚙ Administrar</h2><button class="g n" onclick="admP.classList.remove('on')">Cerrar</button><button class="g n" onclick="logout()">Salir</button></div>
 <p class="note" id="adMsg"></p>
 <h3 id="pf">➕ Nuevo producto</h3><input type="hidden" id="pid">
 <label>Nombre</label><input id="pn">
 <div class="row"><div><label>Precio</label><input id="pp" placeholder="$0.00"></div><div><label>Precio anterior</label><input id="po" placeholder="opcional"></div></div>
 <label>Sección</label><select id="pc"></select>
 <label><input type="checkbox" id="pof" style="width:auto"> 🔥 Está en oferta</label>
 <label>Foto</label><input type="file" id="pi" accept="image/*">
