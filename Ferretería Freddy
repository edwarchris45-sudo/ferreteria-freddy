.ddm{position:fixed;z-index:30;background:var(--card);border-radius:8px;box-shadow:0 10px 30px #0004;min-width:220px;padding:6px;opacity:0;pointer-events:none;transform:translateY(-8px);transition:.2s}.ddm.on{opacity:1;pointer-events:auto;transform:none}
