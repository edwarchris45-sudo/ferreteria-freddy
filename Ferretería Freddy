 <input type="file" id="cfi" accept="image/*" hidden><label>Foto de la sección (opcional, ej. foto de la herramienta)</label><input type="file" id="cim" accept="image/*">
 <div class="row"><input id="cnm" placeholder="Nueva sección"><input id="cem" placeholder="Emoji" style="max-width:70px"><button class="n" onclick="addCat()">Añadir</button></div>
